# Copy to .env.local. Only PUBLIC values belong here: Vite exposes every VITE_ variable to the browser.
# Never put API keys, tokens or other secrets in this project.

# Form service endpoint that receives contact submissions (for example a Formspree or Basin form URL).
VITE_FORM_ENDPOINT=

# Cloudflare Turnstile SITE key (public). Leave blank to use honeypot + timing checks only.
# Verify the token on the server side of your form service; never put the secret key here.
VITE_TURNSTILE_SITE_KEY=

# Plausible domain (e.g. sivatechnomart.com). Leave blank to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Public site URL used for canonical links.
VITE_SITE_URL=
